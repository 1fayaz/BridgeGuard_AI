# BridgeGuard API — environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# src/api/settings.py uses pydantic-settings with env_prefix="BRIDGEGUARD_",
# so every field below must be set as BRIDGEGUARD_<FIELD_NAME_UPPER>.

# --- General ---
BRIDGEGUARD_APP_ENV=development
BRIDGEGUARD_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BRIDGEGUARD_QUEUE_URL=redis://localhost:6379/0
BRIDGEGUARD_REPORT_JOB_MAX_TRIES=3

# --- Secrets (required when BRIDGEGUARD_APP_ENV=production; no defaults) ---
BRIDGEGUARD_JWT_SECRET=generate-a-random-32-char-string-here
BRIDGEGUARD_INTERNAL_TRIGGER_SECRET=generate-a-random-32-char-string-here
BRIDGEGUARD_R2_ACCESS_KEY_ID=your-r2-access-key
BRIDGEGUARD_R2_SECRET_ACCESS_KEY=your-r2-secret-key

# --- JWT verification ---
BRIDGEGUARD_JWT_ALGORITHM=HS256
BRIDGEGUARD_JWT_ISSUER=
BRIDGEGUARD_JWT_AUDIENCE=
BRIDGEGUARD_GATEWAY_KEY_STORE=memory

# --- Cloudflare R2 (S3-compatible) — required in production ---
BRIDGEGUARD_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
BRIDGEGUARD_R2_BUCKET=bridgeguard-reports
BRIDGEGUARD_R2_REGION=auto
BRIDGEGUARD_REPORT_URL_TTL_SECONDS=900

# --- Rate limits (stakeholder-supplied; no safe guessed default — leave unset
#     until a real value is provided, see settings.py TODO sentinel) ---
BRIDGEGUARD_INGEST_RATE_PER_MINUTE=
BRIDGEGUARD_INGEST_BURST_ALLOWANCE=
BRIDGEGUARD_READ_RATE_PER_MINUTE=
BRIDGEGUARD_TRIGGER_RATE_PER_MINUTE=

# --- Request limits ---
BRIDGEGUARD_MAX_INGEST_BATCH_SIZE=1000
BRIDGEGUARD_DEFAULT_PAGE_SIZE=50
BRIDGEGUARD_MAX_PAGE_SIZE=500

# NOTE: frontend/api/index.py and the db/ scripts (migrate.py, seed_sindh.py)
# read UNPREFIXED os.environ vars instead — DATABASE_URL, DEMO_TOKEN,
# SIMULATOR_KEY. This is the src/api vs frontend/api duplication tracked as
# item 6 of the audit; until that's resolved, a deployment running
# frontend/api/index.py also needs:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DEMO_TOKEN=
# SIMULATOR_KEY=
