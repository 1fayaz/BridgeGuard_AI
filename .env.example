# BridgeGuard API — environment variables
# Copy to .env and fill in real values
# NEVER commit .env to git

APP_ENV=production
SECRET_KEY=generate-a-random-32-char-string-here

# Neon database (get from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudflare R2 storage (get from cloudflare dashboard)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=bridgeguard-reports
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Rate limiting (requests per minute — fill after hackathon)
RATE_LIMIT_INGEST=TODO
RATE_LIMIT_API=TODO